DATABASE_URL="file:./dev.db"

# Optional. Leave both empty to run without an LLM.
# With a key, Client Intelligence, Brand, Strategy, Campaign Architect,
# Content Studio, and Video Creative call the model. Posts are labeled LLM.
# Without a key, posts are labeled GENERATED_WITHOUT_LLM and use only the
# fields on the project. Research statistics are never invented.
# If both keys are set, OpenAI is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional. Defaults to https://api.openai.com/v1. Set only for an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5
# How often the database queue claims the next job, in milliseconds. Default 1200.
WORKER_INTERVAL_MS=1200
