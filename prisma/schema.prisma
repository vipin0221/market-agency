generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         Client?
  workflows      Workflow[]
  outputs        Output[]
  approvals      Approval[]
  campaigns      Campaign[]
  contentAssets  ContentAsset[]
  creativeAssets CreativeAsset[]
  integrations   Integration[]
  metrics        Metric[]
  auditLogs      AuditLog[]
  agentRuns      AgentRun[]
}

model Client {
  id           String  @id @default(cuid())
  projectId    String  @unique
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessName String
  industry     String  @default("")
  audience     String  @default("")
  geography    String  @default("")
  goals        String  @default("")
  offers       String  @default("")
  channels     String  @default("")
  budget       String  @default("")
  constraints  String  @default("")
  website      String  @default("")
  notes        String  @default("")
  primaryCta   String  @default("")
  funnel       String  @default("")
}

model Workflow {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestText    String
  status         String
  outcome        String          @default("")
  mode           String          @default("GENERATE")
  cursor         Int             @default(0)
  planJson       String
  blockerSummary String          @default("")
  error          String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  jobs           Job[]
  agentRuns      AgentRun[]
  outputs        Output[]
  approvals      Approval[]
  contentAssets  ContentAsset[]
  creativeAssets CreativeAsset[]
  campaigns      Campaign[]

  @@index([projectId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentKey    String
  status      String
  sequence    Int
  mode        String    @default("GENERATE")
  payloadJson String    @default("{}")
  error       String    @default("")
  attempts    Int       @default(0)
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([workflowId])
}

model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  jobId      String?
  agentKey   String
  status     String
  summary    String    @default("")
  qa         String    @default("")
  error      String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([workflowId, agentKey])
  @@index([projectId])
}

model Output {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  jobId          String?
  agentKey       String
  kind           String
  title          String
  status         String
  summary        String
  generationMode String
  bodyJson       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  approvals      Approval[]
  contentAssets  ContentAsset[]

  @@index([projectId, kind])
  @@index([workflowId])
}

model Approval {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outputId   String?
  output     Output?   @relation(fields: [outputId], references: [id])
  status     String
  note       String    @default("")
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId, status])
  @@index([workflowId])
}

model Campaign {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId    String
  workflow      Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  jobId         String?
  name          String
  objective     String
  channels      String
  status        String
  bodyJson      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contentAssets ContentAsset[]
  metrics       Metric[]

  @@index([projectId])
}

model ContentAsset {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  outputId       String?
  output         Output?   @relation(fields: [outputId], references: [id])
  jobId          String?
  platform       String
  channelSource  String
  funnelStage    String
  angle          String
  hook           String
  headline       String    @default("")
  caption        String
  cta            String
  ctaSource      String
  format         String
  claimsNote     String
  generationMode String
  status         String
  bodyJson       String    @default("{}")
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([workflowId])
}

model CreativeAsset {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  jobId          String?
  kind           String
  title          String
  status         String
  generationMode String
  bodyJson       String
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model Integration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider  String
  label     String
  status    String   @default("NOT_CONNECTED")
  detail    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, provider])
}

model Metric {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  name       String
  value      String
  note       String    @default("")
  source     String
  observedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([projectId])
}

model AuditLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId String?
  actor      String
  action     String
  detail     String
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
}
